# ── Stripe ────────────────────────────────────────────────────────────────
# Copy this file to .env.local for local dev, and add the same variables in
# Vercel → Project → Settings → Environment Variables for production.
#
# REQUIRED for checkout. Server-side only — keep it SECRET, never commit it.
# Get it at https://dashboard.stripe.com/apikeys  (it starts with sk_live_ ...)
STRIPE_SECRET_KEY=your_stripe_secret_key_here

# Publishable key (safe to expose to the browser). Optional for the current
# redirect-based checkout flow, but handy if you add Stripe.js later.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your_stripe_publishable_key_here

# ── Newsletter / email list ───────────────────────────────────────────────
# Where the 10%-off signups are stored. Set ONE of the options below.
#
# Option A — Mailchimp (real audience you can email campaigns to):
#   MAILCHIMP_API_KEY like  abc123def456-us21   (the -us21 part is your data centre)
#   MAILCHIMP_AUDIENCE_ID is the "Audience ID" from Mailchimp → Audience → Settings
MAILCHIMP_API_KEY=
MAILCHIMP_AUDIENCE_ID=
#
# Option B — Any webhook (Google Sheet via Apps Script, Zapier, Make, your ESP).
# The endpoint receives JSON: { email, source, subscribedAt }.
NEWSLETTER_WEBHOOK_URL=
